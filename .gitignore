# ─── Python virtual envs & caches ───────────────────────────────────
.venv/
.myenv/
# if you ever name it "venv" too:
venv/

__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# ─── Gradle & Fabric build outputs ─────────────────────────────────
.gradle/             # local Gradle cache
build/               # all build/ folders (including your mod’s)
out/                 # IntelliJ build dir, if used
run/                 # Fabric’s run/ folder

# keep the Gradle wrapper scripts & JARs!
!gradlew
!gradlew.bat
!/gradle/wrapper/gradle-wrapper.properties
!/gradle/wrapper/gradle-wrapper.jar

# ─── IDE / editor files ─────────────────────────────────────────────
.idea/
*.iml
.vscode/

# ─── OS artifacts & logs ───────────────────────────────────────────
.DS_Store
Thumbs.db
logs/
*.log
*.tmp
