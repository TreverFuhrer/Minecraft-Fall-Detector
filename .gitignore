# ─── Python virtual envs & bytecode ───────────────────────────────
.venv/
.myenv/
venv/

__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# ─── Fabric/Gradle caches & build outputs ─────────────────────────
**/.gradle/             # all .gradle dirs (including loom-cache)
**/build/               # all build/ dirs in any subfolder
**/out/                 # IntelliJ out/
**/run/                 # Fabric run configs
**/bin/                 # Gradle “bin” scripts or build bins

# keep the wrapper scripts & JARs so the project is buildable
!gradlew
!gradlew.bat
!/gradle/wrapper/gradle-wrapper.properties
!/gradle/wrapper/gradle-wrapper.jar

# ─── IDE / editor files ───────────────────────────────────────────
.idea/
*.iml
.vscode/

# ─── OS artifacts & logs ─────────────────────────────────────────
.DS_Store
Thumbs.db

logs/
*.log
*.tmp